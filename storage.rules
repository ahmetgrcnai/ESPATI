rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// ESPATI — Firebase Storage Security Rules
// ─────────────────────────────────────────────────────────────────────────
//
// ⚠️ DO NOT DEPLOY THIS FILE AS-IS — see the identical warning in
// firestore.rules. This only covers paths this pass could verify directly
// from repository code:
//
//   - users/{uid}/profile_image.jpg           (FirestoreUserRepository)
//   - users/{uid}/pets/{petId}.jpg             (FirestorePetRepository)
//   - posts/{authorId}/{fileName}              (FirestorePostRepository)
//   - listings/{authorId}/{listingId}/{n}.jpg  ← new in Phase 1
//
// Merge the `listings` block into your existing Storage rules rather than
// deploying this file wholesale.
// ─────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // 5 MB per file — generous for a single compressed listing/post photo,
    // tight enough to block abuse.
    function underSizeLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    match /users/{uid}/profile_image.jpg {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isImage() && underSizeLimit();
    }

    // `{petId}` is a wildcard for "whatever precedes .jpg" in this path
    // segment — it already covers Çiftleşme's vaccination card upload too
    // (`users/{uid}/pets/{petId}_vaccination.jpg`, see
    // FirestorePetRepository._uploadVaccinationCard) without a separate
    // rule, since the actual check here (isOwner(uid)) never looks at the
    // captured `petId` value.
    match /users/{uid}/pets/{petId}.jpg {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isImage() && underSizeLimit();
    }

    match /posts/{authorId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(authorId) && isImage() && underSizeLimit();
    }

    // listings/{authorId}/{listingId}/{index}.jpg — Phase 1.
    match /listings/{authorId}/{listingId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(authorId) && isImage() && underSizeLimit();
    }

    // communityGroups/{groupId}/cover.jpg — Grup Oluştur's optional cover
    // photo. Unlike the paths above, this one has no uid segment to check
    // against (a group has no single "authorId" field at the Storage
    // layer), so this can't restrict writes to the group's creator the
    // same direct way — that check would need a Firestore lookup
    // (`firestore.get()`), which this pass didn't verify. Scoped to any
    // signed-in user for now; tighten with a creator check before this
    // file is treated as authoritative (see the warning at the top).
    match /communityGroups/{groupId}/cover.jpg {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImage() && underSizeLimit();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
